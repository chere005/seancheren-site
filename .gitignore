# Secrets & credentials — never commit
lib/config.php

# Internal-only notes (e.g. the suite's internal name) — private, never committed
INTERNAL.md

# Local reminder data
data/

# Stray editor/OS cruft
*.swp
.DS_Store

# Sublime per-user session state (keep the .sublime-project, ignore the workspace)
*.sublime-workspace

# server-generated WebP cover cache (built on NFSN, not in repo)
public/akisbookshelf/covers/

# The deploy target names a real SSH login — keep it out of the repo (deploy.conf.sample
# is the tracked template; deploy.sh sources deploy.conf if present).
deploy.conf

# Xcode per-user state (the project itself and its shared schemes are committed)
ios/**/xcuserdata/
ios/**/*.xcuserdatad
ios/build/
ios/DerivedData/
# SwiftPM build products from `swift test` (the CLI test package)
ios/.build/

# Claude Code's per-machine permission grants (the skills themselves are committed)
.claude/settings.local.json

# The in-app browser preview's local launch config — machine-specific paths, never shared
.claude/launch.json
.claude/ralph-loop.local.md
public/status/.page-ver
